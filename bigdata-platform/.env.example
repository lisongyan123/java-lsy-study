# 复制为 .env 后按目标环境修改。
COMPOSE_PROJECT_NAME=bigdata-platform

# 宿主机上的外部 JAR 根目录；其下必须包含 common、spark、flink。
# Linux 示例：/opt/bigdata-jars；Windows 示例：D:/bigdata-jars。
JAR_ROOT=C:/Users/84216/Desktop/bigdata-platform

MINIO_IMAGE=minio/minio:latest
MINIO_CLIENT_IMAGE=minio/mc:latest
MYSQL_IMAGE=mysql:8.4
POSTGRES_IMAGE=postgres:16-alpine
KAFKA_IMAGE=apache/kafka:4.1.0
SPARK_IMAGE=apache/spark:3.5.5
TRINO_IMAGE=trinodb/trino:476
FLINK_IMAGE=flink:1.20.1-scala_2.12-java17
HIVE_METASTORE_IMAGE=apache/hive:4.0.1
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.4
OPENMETADATA_IMAGE=openmetadata/server:1.5.9

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MYSQL_PORT=3306
POSTGRES_PORT=5433
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_ADVERTISED_HOST=localhost
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
FLINK_UI_PORT=8082
TRINO_PORT=8088
HIVE_METASTORE_PORT=9083
ELASTICSEARCH_PORT=9200
OPENMETADATA_PORT=8585
OPENMETADATA_ADMIN_PORT=8586

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_WAREHOUSE_BUCKET=warehouse
MINIO_CHECKPOINT_BUCKET=checkpoints
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=cdc_db
MYSQL_USER=cdc
MYSQL_PASSWORD=change-me
ICEBERG_CATALOG_DATABASE=iceberg_catalog
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=change-me
ICEBERG_WAREHOUSE=s3://warehouse/iceberg
HIVE_METASTORE_URI=thrift://hive-metastore:9083
HIVE_METASTORE_DATABASE=hive_metastore
HIVE_METASTORE_USER=hive
HIVE_METASTORE_PASSWORD=change-me
HUDI_WAREHOUSE=s3a://warehouse/hudi
PAIMON_WAREHOUSE=s3://warehouse/paimon
POSTGRES_DB=sink_db
POSTGRES_USER=sink
POSTGRES_PASSWORD=change-me
OPENMETADATA_DB_USER=openmetadata
OPENMETADATA_DB_PASSWORD=change-me
OPENMETADATA_DATABASE=openmetadata_db

SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2
FLINK_PARALLELISM=2
FLINK_TASK_SLOTS=4
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g